# Aucun secret n'est fourni. Variables exclusivement serveur.
# Pour le simulateur Cloudflare local : copier ce fichier vers .dev.vars.
# Laisser vide pour demarrer sans connecter de compte externe.
OPENAI_API_KEY=
OPENAI_MODEL=

# Cle AES-GCM : 32 octets aleatoires encodes en base64 (a generer localement).
MORICE_ENCRYPTION_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Facultatif : URL confidentielle d'un webhook Make autorise.
MAKE_WEBHOOK_URL=
