<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F3F7FC">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="28dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TON ASSISTANT PERSONNEL" android:textSize="12sp" android:letterSpacing="0.08" android:textColor="#087C87" android:layout_marginBottom="24dp" />
  <ImageView android:layout_width="170dp" android:layout_height="170dp" android:src="@drawable/morice_widget" android:contentDescription="Logo officiel de Morice" android:scaleType="fitCenter" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bonjour, Alan." android:textSize="32sp" android:textStyle="bold" android:textColor="#152B46" android:layout_marginTop="20dp" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Une idée, une question, quelque chose à faire ?" android:textSize="16sp" android:textColor="#526780" android:gravity="center" android:layout_marginTop="12dp" android:layout_marginBottom="32dp" />
  <Button android:id="@+id/talk_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:padding="16dp" android:background="@drawable/button_primary" android:text="Parler à Morice" android:textAllCaps="false" android:textSize="17sp" android:textColor="#FFFFFF" />
  <Button android:id="@+id/open_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:padding="16dp" android:background="@drawable/button_secondary" android:text="Ouvrir ma conversation" android:textAllCaps="false" android:textSize="16sp" android:textColor="#194BB9" android:layout_marginTop="12dp" />
  <Button android:id="@+id/widget_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:padding="16dp" android:background="@drawable/button_secondary" android:text="Ajouter le widget à l’accueil" android:textAllCaps="false" android:textSize="16sp" android:textColor="#087C87" android:layout_marginTop="12dp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Le micro démarre uniquement quand tu le demandes. Relis ta dictée avant de l’envoyer." android:textSize="14sp" android:textColor="#526780" android:gravity="center" android:layout_marginTop="24dp" />
 </LinearLayout>
</ScrollView>
